# Colosseum backend config. On the droplet this file lives at
# /opt/apps/colosseum/.env and docker-compose bind-mounts it into the container.
# DATABASE_URL and BACKUP_DIR are set by docker-compose.yml, not here.

# The Blue Alliance v3 read key (https://www.thebluealliance.com/account).
TBA_API_KEY=

# Legion SSO. SSO_SECRET must be identical to Legion's SSO_SECRET; LEGION_API_KEY is the
# key Legion issued for Colosseum (its COLOSSEUM_API_KEY). Colosseum only verifies the
# mw_sso cookie — it never mints one.
SSO_SECRET=
LEGION_BASE_URL=https://legion.marswars.org
LEGION_API_KEY=

# Public URL, used to absolutize the SSO return path.
BASE_URL=https://colosseum.marswars.org

# Teams allowed to sign in; each is its own workspace. Anyone whose Legion team_number
# is not in this list gets a 403.
ALLOWED_TEAM_NUMBERS=4143,4423

# Statbotics EPA is optional and off by default (the API is unreliable). Set true to
# show the EPA column; any failure just hides it.
STATBOTICS_ENABLED=false

TIMEZONE=America/Chicago
