# Local development env for the Colosseum backend. Copy to `server/.env`.
# (On the droplet the real values live at the repo root as `colosseum/.env`, which
#  docker-compose bind-mounts to the container's working dir.)

# The Blue Alliance v3 read key (https://www.thebluealliance.com/account). Without it the
# TBA proxy returns errors.
TBA_API_KEY=

# Legion SSO. SSO_SECRET must equal Legion's SSO_SECRET; LEGION_API_KEY is the key Legion
# issued for this app. Leave blank for pure local dev and use server/devlogin.py to mint a
# cookie instead.
SSO_SECRET=
LEGION_BASE_URL=https://legion.marswars.org
LEGION_API_KEY=

# Teams allowed to sign in; each is its own workspace.
ALLOWED_TEAM_NUMBERS=4143,4423

# Public URL of this app, used to absolutize the SSO return path.
BASE_URL=http://localhost:5173

STATBOTICS_ENABLED=false
